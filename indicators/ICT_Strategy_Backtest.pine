// © KingRafer — ICT Strategy Backtest
//@version=5
strategy("ICT Strategy Backtest", shorttitle="ICT BT",
     overlay=true, pyramiding=0,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=0.5,
     process_orders_on_close=true)

// ─── Inputs ───
swingLen = input.int(5, "Swing Length", minval=2, maxval=10)
rrTP     = input.float(2.0, "Take Profit RR", minval=1.0, step=0.1)
slBuf    = input.float(0.25, "SL Buffer (ATR)", minval=0.05, step=0.05)
onlySB   = input.bool(false, "Only Silver Bullet 10-11 NY")

// ─── Swings ───
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var string bias  = "neutral"

if not na(ph)
    lastSH := ph
if not na(pl)
    lastSL := pl

atrVal = ta.atr(14)
nyHour = hour(time, "America/New_York")
inSB   = nyHour >= 10 and nyHour < 11

// ─── Structure bias ───
if barstate.isconfirmed and not na(lastSH) and not na(lastSL)
    if close > lastSH
        bias := "bull"
    if close < lastSL
        bias := "bear"

// ─── Turtle Soup (main signal) ───
tsLong  = not na(lastSL) and low < lastSL and close > lastSL
tsShort = not na(lastSH) and high > lastSH and close < lastSH

// Optional: only during Silver Bullet
longOK  = tsLong  and (not onlySB or inSB)
shortOK = tsShort and (not onlySB or inSB)

// ─── Entry + Exit ───
if longOK and strategy.position_size == 0
    sl   = lastSL - atrVal * slBuf
    risk = close - sl
    if risk > 0
        tp = close + risk * rrTP
        strategy.entry("Long", strategy.long)
        strategy.exit("Long Exit", "Long", stop=sl, limit=tp)

if shortOK and strategy.position_size == 0
    sl   = lastSH + atrVal * slBuf
    risk = sl - close
    if risk > 0
        tp = close - risk * rrTP
        strategy.entry("Short", strategy.short)
        strategy.exit("Short Exit", "Short", stop=sl, limit=tp)

// ─── Visual ───
plotshape(longOK,  style=shape.triangleup,   location=location.belowbar, color=#22c55e, size=size.small, title="Long")
plotshape(shortOK, style=shape.triangledown, location=location.abovebar, color=#ef4444, size=size.small, title="Short")
bgcolor(inSB ? color.new(#a855f7, 93) : na)

plot(strategy.position_size > 0 ? strategy.position_avg_price : na, "Long Entry", color=#22c55e, style=plot.style_linebr)
plot(strategy.position_size < 0 ? strategy.position_avg_price : na, "Short Entry", color=#ef4444, style=plot.style_linebr)
