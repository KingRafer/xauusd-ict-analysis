// © KingRafer — ICT / Smart Money Concepts (Stable)
//@version=5
indicator("ICT Full SMC", shorttitle="ICT SMC", overlay=true, max_boxes_count=80, max_lines_count=60, max_labels_count=40)

// ══════════════════════════════════════
// INPUTS
// ══════════════════════════════════════
showFVG     = input.bool(true,  "Show FVG")
showIFVG    = input.bool(true,  "Show Inversion FVG")
showMS      = input.bool(true,  "Show BOS / CHoCH")
showOTE     = input.bool(true,  "Show OTE Zone")
showOB      = input.bool(true,  "Show Order Blocks")
showLiq     = input.bool(true,  "Show Liquidity")
showTurtle  = input.bool(true,  "Show Turtle Soup")
showSB      = input.bool(true,  "Show Silver Bullet Window")
showCISD    = input.bool(true,  "Show CISD")
showCRT     = input.bool(true,  "Show CRT (Prev Candle)")
showPO3     = input.bool(true,  "Show Session Background")

swingLen    = input.int(5,  "Swing Length", minval=2, maxval=15)
extendFVG   = input.int(20, "FVG Extend Bars", minval=5)
oteLen      = input.int(30, "OTE Lookback", minval=10)
sbStart     = input.int(10, "Silver Bullet Start (NY hour)", minval=0, maxval=23)
sbEnd       = input.int(11, "Silver Bullet End (NY hour)", minval=0, maxval=23)
cisdMult    = input.float(1.4, "CISD ATR Mult", minval=1.0, step=0.1)

bullCol = color.new(#22c55e, 80)
bearCol = color.new(#ef4444, 80)
oteCol  = color.new(#3b82f6, 88)
sbCol   = color.new(#a855f7, 92)

// ══════════════════════════════════════
// COMMON
// ══════════════════════════════════════
atrVal = ta.atr(14)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var int   shBar  = na
var int   slBar  = na
var string bias  = "neutral"

if not na(ph)
    lastSH := ph
    shBar  := bar_index - swingLen
if not na(pl)
    lastSL := pl
    slBar  := bar_index - swingLen

// ══════════════════════════════════════
// 1. FAIR VALUE GAP
// ══════════════════════════════════════
var box[] bFVG = array.new_box()
var box[] sFVG = array.new_box()
var box[] iFVG = array.new_box()

if showFVG and barstate.isconfirmed
    // Bullish FVG
    if low > high[2]
        bx = box.new(bar_index - 2, low, bar_index + extendFVG, high[2], border_color=#22c55e, bgcolor=bullCol, text="FVG", text_size=size.tiny, text_color=#22c55e)
        array.push(bFVG, bx)
        if array.size(bFVG) > 10
            box.delete(array.shift(bFVG))

    // Bearish FVG
    if high < low[2]
        bx = box.new(bar_index - 2, low[2], bar_index + extendFVG, high, border_color=#ef4444, bgcolor=bearCol, text="FVG", text_size=size.tiny, text_color=#ef4444)
        array.push(sFVG, bx)
        if array.size(sFVG) > 10
            box.delete(array.shift(sFVG))

// Mitigate + Inversion
if barstate.isconfirmed
    if array.size(bFVG) > 0
        for i = array.size(bFVG) - 1 to 0
            bx = array.get(bFVG, i)
            if low <= box.get_bottom(bx)
                if showIFVG
                    inv = box.new(box.get_left(bx), box.get_top(bx), bar_index + 8, box.get_bottom(bx), border_color=#eab308, bgcolor=color.new(#eab308, 90), text="iFVG", text_size=size.tiny, text_color=#eab308)
                    array.push(iFVG, inv)
                    if array.size(iFVG) > 6
                        box.delete(array.shift(iFVG))
                box.delete(bx)
                array.remove(bFVG, i)

    if array.size(sFVG) > 0
        for i = array.size(sFVG) - 1 to 0
            bx = array.get(sFVG, i)
            if high >= box.get_top(bx)
                if showIFVG
                    inv = box.new(box.get_left(bx), box.get_top(bx), bar_index + 8, box.get_bottom(bx), border_color=#eab308, bgcolor=color.new(#eab308, 90), text="iFVG", text_size=size.tiny, text_color=#eab308)
                    array.push(iFVG, inv)
                    if array.size(iFVG) > 6
                        box.delete(array.shift(iFVG))
                box.delete(bx)
                array.remove(sFVG, i)

// ══════════════════════════════════════
// 2. MARKET STRUCTURE BOS / CHoCH
// ══════════════════════════════════════
var line  msLine = na
var label msLab  = na

if showMS and barstate.isconfirmed and not na(lastSH) and not na(lastSL)
    if close > lastSH and bias != "bull"
        txt = bias == "bear" ? "CHoCH ▲" : "BOS ▲"
        if not na(msLine)
            line.delete(msLine)
        if not na(msLab)
            label.delete(msLab)
        msLine := line.new(shBar, lastSH, bar_index, lastSH, color=#22c55e, style=line.style_dashed)
        msLab  := label.new(bar_index, lastSH, txt, style=label.style_label_down, color=#22c55e, textcolor=color.white, size=size.small)
        bias   := "bull"

    if close < lastSL and bias != "bear"
        txt = bias == "bull" ? "CHoCH ▼" : "BOS ▼"
        if not na(msLine)
            line.delete(msLine)
        if not na(msLab)
            label.delete(msLab)
        msLine := line.new(slBar, lastSL, bar_index, lastSL, color=#ef4444, style=line.style_dashed)
        msLab  := label.new(bar_index, lastSL, txt, style=label.style_label_up, color=#ef4444, textcolor=color.white, size=size.small)
        bias   := "bear"

// ══════════════════════════════════════
// 3. OTE ZONE (0.618 - 0.786)
// ══════════════════════════════════════
var box  oteB = na
var line ote1 = na
var line ote2 = na

if showOTE and barstate.islast
    hi = ta.highest(high, oteLen)
    lo = ta.lowest(low, oteLen)
    rng = hi - lo
    top = lo + rng * 0.786
    bot = lo + rng * 0.618

    if not na(oteB)
        box.delete(oteB)
    if not na(ote1)
        line.delete(ote1)
    if not na(ote2)
        line.delete(ote2)

    oteB := box.new(bar_index - oteLen, top, bar_index + 3, bot, border_color=#3b82f6, bgcolor=oteCol, text="OTE", text_size=size.tiny, text_color=#3b82f6)
    ote1 := line.new(bar_index - oteLen, bot, bar_index + 3, bot, color=#3b82f6, style=line.style_dotted)
    ote2 := line.new(bar_index - oteLen, top, bar_index + 3, top, color=#3b82f6, style=line.style_dotted)

// ══════════════════════════════════════
// 4. ORDER BLOCK
// ══════════════════════════════════════
var box[] bOB = array.new_box()
var box[] sOB = array.new_box()

if showOB and barstate.isconfirmed
    if close[1] < open[1] and close > high[1] and (close - open) > atrVal * 0.5
        bx = box.new(bar_index - 1, high[1], bar_index + 12, low[1], border_color=#22c55e, bgcolor=color.new(#22c55e, 90), text="OB", text_size=size.tiny, text_color=#22c55e)
        array.push(bOB, bx)
        if array.size(bOB) > 6
            box.delete(array.shift(bOB))

    if close[1] > open[1] and close < low[1] and (open - close) > atrVal * 0.5
        bx = box.new(bar_index - 1, high[1], bar_index + 12, low[1], border_color=#ef4444, bgcolor=color.new(#ef4444, 90), text="OB", text_size=size.tiny, text_color=#ef4444)
        array.push(sOB, bx)
        if array.size(sOB) > 6
            box.delete(array.shift(sOB))

// ══════════════════════════════════════
// 5. LIQUIDITY + TURTLE SOUP
// ══════════════════════════════════════
var line liqH = na
var line liqL = na

if showLiq and barstate.islast and not na(lastSH)
    if not na(liqH)
        line.delete(liqH)
    liqH := line.new(shBar, lastSH, bar_index + 10, lastSH, color=color.new(#f59e0b, 40), style=line.style_dotted)

if showLiq and barstate.islast and not na(lastSL)
    if not na(liqL)
        line.delete(liqL)
    liqL := line.new(slBar, lastSL, bar_index + 10, lastSL, color=color.new(#f59e0b, 40), style=line.style_dotted)

turtleLong  = showTurtle and not na(lastSL) and low < lastSL and close > lastSL
turtleShort = showTurtle and not na(lastSH) and high > lastSH and close < lastSH

plotshape(turtleLong,  title="TS Long",  style=shape.triangleup,   location=location.belowbar, color=#22c55e, size=size.small, text="TS")
plotshape(turtleShort, title="TS Short", style=shape.triangledown, location=location.abovebar, color=#ef4444, size=size.small, text="TS")

// ══════════════════════════════════════
// 6. SILVER BULLET (NY time)
// ══════════════════════════════════════
nyHour = hour(time, "America/New_York")
inSB   = nyHour >= sbStart and nyHour < sbEnd

bgcolor(showSB and inSB ? sbCol : na, title="Silver Bullet")

// ══════════════════════════════════════
// 7. CISD
// ══════════════════════════════════════
cisdUp   = showCISD and close > open and (close - open) > atrVal * cisdMult and close > high[1]
cisdDown = showCISD and close < open and (open - close) > atrVal * cisdMult and close < low[1]

plotshape(cisdUp,   title="CISD Up",   style=shape.diamond, location=location.belowbar, color=#22c55e, size=size.tiny, text="CISD")
plotshape(cisdDown, title="CISD Down", style=shape.diamond, location=location.abovebar, color=#ef4444, size=size.tiny, text="CISD")

// ══════════════════════════════════════
// 8. CRT - Previous Candle Range
// ══════════════════════════════════════
var line crtH = na
var line crtL = na

if showCRT and barstate.islast
    if not na(crtH)
        line.delete(crtH)
    if not na(crtL)
        line.delete(crtL)
    crtH := line.new(bar_index - 1, high[1], bar_index + 6, high[1], color=color.new(#94a3b8, 50), style=line.style_dotted)
    crtL := line.new(bar_index - 1, low[1],  bar_index + 6, low[1],  color=color.new(#94a3b8, 50), style=line.style_dotted)

// ══════════════════════════════════════
// 9. POWER OF THREE - Session BG
// ══════════════════════════════════════
isAsia   = showPO3 and (nyHour >= 19 or nyHour < 3)
isLondon = showPO3 and nyHour >= 3 and nyHour < 8
isNY     = showPO3 and nyHour >= 8 and nyHour < 17

bgcolor(isAsia ? color.new(#64748b, 95) : na, title="Asia")
bgcolor(isLondon ? color.new(#f59e0b, 95) : na, title="London")
bgcolor(isNY and not inSB ? color.new(#3b82f6, 96) : na, title="New York")

// ══════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════
var table tb = table.new(position.top_right, 2, 4, bgcolor=color.new(#0b0f14, 20), border_width=1)

if barstate.islast
    table.cell(tb, 0, 0, "Bias", text_color=#8b9cb3, text_size=size.small)
    table.cell(tb, 1, 0, bias == "bull" ? "BULLISH" : bias == "bear" ? "BEARISH" : "NEUTRAL", text_color=bias == "bull" ? #22c55e : bias == "bear" ? #ef4444 : #8b9cb3, text_size=size.small)

    table.cell(tb, 0, 1, "Session", text_color=#8b9cb3, text_size=size.small)
    sessName = inSB ? "SILVER BULLET" : isLondon ? "London" : isNY ? "New York" : isAsia ? "Asia" : "—"
    table.cell(tb, 1, 1, sessName, text_color=#a855f7, text_size=size.small)

    table.cell(tb, 0, 2, "Swing H", text_color=#8b9cb3, text_size=size.tiny)
    table.cell(tb, 1, 2, na(lastSH) ? "—" : str.tostring(lastSH, "#.##"), text_color=color.white, text_size=size.tiny)

    table.cell(tb, 0, 3, "Swing L", text_color=#8b9cb3, text_size=size.tiny)
    table.cell(tb, 1, 3, na(lastSL) ? "—" : str.tostring(lastSL, "#.##"), text_color=color.white, text_size=size.tiny)

// Swing markers
plotshape(showMS and not na(ph), style=shape.triangledown, location=location.abovebar, color=color.new(#ef4444, 70), size=size.tiny)
plotshape(showMS and not na(pl), style=shape.triangleup,   location=location.belowbar, color=color.new(#22c55e, 70), size=size.tiny)
