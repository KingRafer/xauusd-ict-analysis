// © KingRafer — ICT Strategies from video (Smart Risk style)
// Silver Bullet | Cameron's Model | IFVG | Turtle Soup | CRT | OTE | CISD | PO3
//@version=5
indicator("ICT Strategies (Video)", shorttitle="ICT Video", overlay=true, max_boxes_count=50, max_lines_count=40, max_labels_count=30)

// ══════════════════════════════════════
// INPUTS
// ══════════════════════════════════════
showFVG     = input.bool(true, "1. Fair Value Gap")
showIFVG    = input.bool(true, "2. Inversion FVG")
showMS      = input.bool(true, "3. Market Structure (BOS/CHoCH)")
showOTE     = input.bool(true, "4. Optimal Trade Entry (0.62-0.79)")
showTurtle  = input.bool(true, "5. Turtle Soup")
showCRT     = input.bool(true, "6. Candle Range Theory")
showCISD    = input.bool(true, "7. CISD")
showSB      = input.bool(true, "8. Silver Bullet Window")
showPO3     = input.bool(true, "9. Power of Three Sessions")

swingLen    = input.int(5, "Swing Length", minval=2, maxval=12)
extendFVG   = input.int(20, "FVG Extend", minval=5)
oteLen      = input.int(40, "OTE Lookback", minval=15)
sbStart     = input.int(10, "Silver Bullet Start (NY)", minval=0, maxval=23)
sbEnd       = input.int(11, "Silver Bullet End (NY)", minval=0, maxval=23)

bullCol = color.new(#22c55e, 82)
bearCol = color.new(#ef4444, 82)
oteCol  = color.new(#3b82f6, 88)
sbCol   = color.new(#a855f7, 92)

// ══════════════════════════════════════
// COMMON
// ══════════════════════════════════════
atrVal = ta.atr(14)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var int   shBar  = na
var int   slBar  = na
var string bias  = "neutral"

if not na(ph)
    lastSH := ph
    shBar  := bar_index - swingLen
if not na(pl)
    lastSL := pl
    slBar  := bar_index - swingLen

nyHour = hour(time, "America/New_York")
inSB   = nyHour >= sbStart and nyHour < sbEnd

// ══════════════════════════════════════
// 1. FAIR VALUE GAP + 2. INVERSION FVG
// ══════════════════════════════════════
var box[] bFVG = array.new_box()
var box[] sFVG = array.new_box()
var box[] iFVG = array.new_box()

if showFVG and barstate.isconfirmed
    // Bullish FVG: gap between candle[2] high and current low
    if low > high[2]
        bx = box.new(bar_index-2, low, bar_index+extendFVG, high[2], border_color=#22c55e, bgcolor=bullCol, text="FVG", text_size=size.tiny, text_color=#22c55e)
        array.push(bFVG, bx)
        if array.size(bFVG) > 8
            box.delete(array.shift(bFVG))

    // Bearish FVG
    if high < low[2]
        bx = box.new(bar_index-2, low[2], bar_index+extendFVG, high, border_color=#ef4444, bgcolor=bearCol, text="FVG", text_size=size.tiny, text_color=#ef4444)
        array.push(sFVG, bx)
        if array.size(sFVG) > 8
            box.delete(array.shift(sFVG))

// Mitigate + create Inversion FVG
if barstate.isconfirmed
    if array.size(bFVG) > 0
        for i = array.size(bFVG)-1 to 0
            bx = array.get(bFVG, i)
            if low <= box.get_bottom(bx)
                if showIFVG
                    inv = box.new(box.get_left(bx), box.get_top(bx), bar_index+10, box.get_bottom(bx), border_color=#eab308, bgcolor=color.new(#eab308, 88), text="iFVG", text_size=size.tiny, text_color=#eab308)
                    array.push(iFVG, inv)
                    if array.size(iFVG) > 5
                        box.delete(array.shift(iFVG))
                box.delete(bx)
                array.remove(bFVG, i)

    if array.size(sFVG) > 0
        for i = array.size(sFVG)-1 to 0
            bx = array.get(sFVG, i)
            if high >= box.get_top(bx)
                if showIFVG
                    inv = box.new(box.get_left(bx), box.get_top(bx), bar_index+10, box.get_bottom(bx), border_color=#eab308, bgcolor=color.new(#eab308, 88), text="iFVG", text_size=size.tiny, text_color=#eab308)
                    array.push(iFVG, inv)
                    if array.size(iFVG) > 5
                        box.delete(array.shift(iFVG))
                box.delete(bx)
                array.remove(sFVG, i)

// ══════════════════════════════════════
// 3. MARKET STRUCTURE (for Silver Bullet & Cameron)
// ══════════════════════════════════════
var line  msLine = na
var label msLab  = na

if showMS and barstate.isconfirmed and not na(lastSH) and not na(lastSL)
    if close > lastSH and bias != "bull"
        txt = bias == "bear" ? "CHoCH ▲" : "BOS ▲"
        if not na(msLine)
            line.delete(msLine)
        if not na(msLab)
            label.delete(msLab)
        msLine := line.new(shBar, lastSH, bar_index, lastSH, color=#22c55e, style=line.style_dashed)
        msLab  := label.new(bar_index, lastSH, txt, style=label.style_label_down, color=#22c55e, textcolor=color.white, size=size.small)
        bias   := "bull"

    if close < lastSL and bias != "bear"
        txt = bias == "bull" ? "CHoCH ▼" : "BOS ▼"
        if not na(msLine)
            line.delete(msLine)
        if not na(msLab)
            label.delete(msLab)
        msLine := line.new(slBar, lastSL, bar_index, lastSL, color=#ef4444, style=line.style_dashed)
        msLab  := label.new(bar_index, lastSL, txt, style=label.style_label_up, color=#ef4444, textcolor=color.white, size=size.small)
        bias   := "bear"

// ══════════════════════════════════════
// 4. OPTIMAL TRADE ENTRY (OTE)
// ══════════════════════════════════════
var box oteB = na

if showOTE and barstate.islast
    hi = ta.highest(high, oteLen)
    lo = ta.lowest(low, oteLen)
    top = lo + (hi-lo)*0.786
    bot = lo + (hi-lo)*0.618
    if not na(oteB)
        box.delete(oteB)
    oteB := box.new(bar_index-oteLen, top, bar_index+3, bot, border_color=#3b82f6, bgcolor=oteCol, text="OTE 0.62-0.79", text_size=size.tiny, text_color=#3b82f6)

// ══════════════════════════════════════
// 5. TURTLE SOUP
// ══════════════════════════════════════
turtleLong  = showTurtle and not na(lastSL) and low < lastSL and close > lastSL
turtleShort = showTurtle and not na(lastSH) and high > lastSH and close < lastSH

plotshape(turtleLong,  title="Turtle Soup Long",  style=shape.triangleup,   location=location.belowbar, color=#22c55e, size=size.small, text="TS")
plotshape(turtleShort, title="Turtle Soup Short", style=shape.triangledown, location=location.abovebar, color=#ef4444, size=size.small, text="TS")

// ══════════════════════════════════════
// 6. CANDLE RANGE THEORY (prev candle H/L)
// ══════════════════════════════════════
var line crtH = na
var line crtL = na

if showCRT and barstate.islast
    if not na(crtH)
        line.delete(crtH)
    if not na(crtL)
        line.delete(crtL)
    crtH := line.new(bar_index-1, high[1], bar_index+8, high[1], color=color.new(#94a3b8, 40), style=line.style_dotted)
    crtL := line.new(bar_index-1, low[1],  bar_index+8, low[1],  color=color.new(#94a3b8, 40), style=line.style_dotted)

// ══════════════════════════════════════
// 7. CISD (strong displacement)
// ══════════════════════════════════════
cisdUp   = showCISD and close > open and (close-open) > atrVal*1.4 and close > high[1]
cisdDown = showCISD and close < open and (open-close) > atrVal*1.4 and close < low[1]

plotshape(cisdUp,   title="CISD Up",   style=shape.diamond, location=location.belowbar, color=#22c55e, size=size.tiny, text="CISD")
plotshape(cisdDown, title="CISD Down", style=shape.diamond, location=location.abovebar, color=#ef4444, size=size.tiny, text="CISD")

// ══════════════════════════════════════
// 8. SILVER BULLET WINDOW
// ══════════════════════════════════════
bgcolor(showSB and inSB ? sbCol : na, title="Silver Bullet")

// ══════════════════════════════════════
// 9. POWER OF THREE (session backgrounds)
// ══════════════════════════════════════
isAsia   = showPO3 and (nyHour >= 19 or nyHour < 3)
isLondon = showPO3 and nyHour >= 3 and nyHour < 8
isNY     = showPO3 and nyHour >= 8 and nyHour < 17

bgcolor(isAsia ? color.new(#64748b, 95) : na, title="Asia (Accumulation)")
bgcolor(isLondon ? color.new(#f59e0b, 95) : na, title="London (Manipulation)")
bgcolor(isNY and not inSB ? color.new(#3b82f6, 96) : na, title="NY (Distribution)")

// ══════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════
var table tb = table.new(position.top_right, 2, 4, bgcolor=color.new(#0b0f14, 15), border_width=1)

if barstate.islast
    table.cell(tb, 0, 0, "Bias", text_color=#8b9cb3, text_size=size.small)
    table.cell(tb, 1, 0, bias == "bull" ? "BULLISH" : bias == "bear" ? "BEARISH" : "NEUTRAL", text_color=bias == "bull" ? #22c55e : bias == "bear" ? #ef4444 : #8b9cb3, text_size=size.small)

    table.cell(tb, 0, 1, "Session", text_color=#8b9cb3, text_size=size.small)
    sess = inSB ? "SILVER BULLET" : isLondon ? "London" : isNY ? "New York" : isAsia ? "Asia" : "—"
    table.cell(tb, 1, 1, sess, text_color=#a855f7, text_size=size.small)

    table.cell(tb, 0, 2, "Swing H", text_color=#8b9cb3, text_size=size.tiny)
    table.cell(tb, 1, 2, na(lastSH) ? "—" : str.tostring(lastSH, "#.##"), text_color=color.white, text_size=size.tiny)

    table.cell(tb, 0, 3, "Swing L", text_color=#8b9cb3, text_size=size.tiny)
    table.cell(tb, 1, 3, na(lastSL) ? "—" : str.tostring(lastSL, "#.##"), text_color=color.white, text_size=size.tiny)

// Swing markers
plotshape(showMS and not na(ph), style=shape.triangledown, location=location.abovebar, color=color.new(#ef4444, 70), size=size.tiny)
plotshape(showMS and not na(pl), style=shape.triangleup,   location=location.belowbar, color=color.new(#22c55e, 70), size=size.tiny)
