// © KingRafer — ICT Simple & Accurate
// FVG + BOS/CHoCH + Turtle Soup + Silver Bullet
//@version=5
indicator("ICT Simple", shorttitle="ICT", overlay=true, max_boxes_count=20, max_lines_count=10, max_labels_count=15)

// ─── Inputs ───
showFVG    = input.bool(true, "Fair Value Gap")
showMS     = input.bool(true, "BOS / CHoCH")
showTurtle = input.bool(true, "Turtle Soup")
showSB     = input.bool(true, "Silver Bullet (10-11 NY)")
swingLen   = input.int(5, "Swing Length", minval=3, maxval=10)
fvgBars    = input.int(15, "FVG Max Bars", minval=5, maxval=30)

// ─── Swings ───
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var int   shBar  = na
var int   slBar  = na
var string bias  = "neutral"

if not na(ph)
    lastSH := ph
    shBar  := bar_index - swingLen
if not na(pl)
    lastSL := pl
    slBar  := bar_index - swingLen

nyHour = hour(time, "America/New_York")
inSB   = nyHour >= 10 and nyHour < 11

// ─── 1. FVG (max 4 each side, auto remove when filled) ───
var box[] bFVG = array.new_box()
var box[] sFVG = array.new_box()

if showFVG and barstate.isconfirmed
    // Bullish FVG
    if low > high[2]
        bx = box.new(bar_index-2, low, bar_index+fvgBars, high[2], border_color=#22c55e, bgcolor=color.new(#22c55e, 85), text="FVG", text_size=size.tiny, text_color=#22c55e)
        array.push(bFVG, bx)
        if array.size(bFVG) > 4
            box.delete(array.shift(bFVG))
    // Bearish FVG
    if high < low[2]
        bx = box.new(bar_index-2, low[2], bar_index+fvgBars, high, border_color=#ef4444, bgcolor=color.new(#ef4444, 85), text="FVG", text_size=size.tiny, text_color=#ef4444)
        array.push(sFVG, bx)
        if array.size(sFVG) > 4
            box.delete(array.shift(sFVG))

// Remove filled FVG
if barstate.isconfirmed
    if array.size(bFVG) > 0
        for i = array.size(bFVG)-1 to 0
            bx = array.get(bFVG, i)
            if low <= box.get_bottom(bx)
                box.delete(bx)
                array.remove(bFVG, i)
    if array.size(sFVG) > 0
        for i = array.size(sFVG)-1 to 0
            bx = array.get(sFVG, i)
            if high >= box.get_top(bx)
                box.delete(bx)
                array.remove(sFVG, i)

// ─── 2. BOS / CHoCH (one line only) ───
var line  msLine = na
var label msLab  = na

if showMS and barstate.isconfirmed and not na(lastSH) and not na(lastSL)
    if close > lastSH and bias != "bull"
        txt = bias == "bear" ? "CHoCH" : "BOS"
        if not na(msLine)
            line.delete(msLine)
        if not na(msLab)
            label.delete(msLab)
        msLine := line.new(shBar, lastSH, bar_index, lastSH, color=#22c55e, style=line.style_dashed)
        msLab  := label.new(bar_index, lastSH, txt + " ▲", style=label.style_label_down, color=#22c55e, textcolor=color.white, size=size.small)
        bias   := "bull"

    if close < lastSL and bias != "bear"
        txt = bias == "bull" ? "CHoCH" : "BOS"
        if not na(msLine)
            line.delete(msLine)
        if not na(msLab)
            label.delete(msLab)
        msLine := line.new(slBar, lastSL, bar_index, lastSL, color=#ef4444, style=line.style_dashed)
        msLab  := label.new(bar_index, lastSL, txt + " ▼", style=label.style_label_up, color=#ef4444, textcolor=color.white, size=size.small)
        bias   := "bear"

// ─── 3. Turtle Soup ───
tsLong  = showTurtle and not na(lastSL) and low < lastSL and close > lastSL and barstate.isconfirmed
tsShort = showTurtle and not na(lastSH) and high > lastSH and close < lastSH and barstate.isconfirmed

plotshape(tsLong,  title="TS Long",  style=shape.triangleup,   location=location.belowbar, color=#22c55e, size=size.small, text="TS")
plotshape(tsShort, title="TS Short", style=shape.triangledown, location=location.abovebar, color=#ef4444, size=size.small, text="TS")

// ─── 4. Silver Bullet window ───
bgcolor(showSB and inSB ? color.new(#a855f7, 92) : na, title="Silver Bullet")

// SB + structure/turtle confluence label
if showSB and inSB and barstate.isconfirmed
    if tsLong or (close > lastSH and bias == "bull")
        label.new(bar_index, low, "SB", style=label.style_label_up, color=#a855f7, textcolor=color.white, size=size.tiny)
    if tsShort or (close < lastSL and bias == "bear")
        label.new(bar_index, high, "SB", style=label.style_label_down, color=#a855f7, textcolor=color.white, size=size.tiny)

// ─── Simple table ───
var table tb = table.new(position.top_right, 2, 2, bgcolor=color.new(#0b0f14, 20), border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "Bias", text_color=#94a3b8, text_size=size.small)
    table.cell(tb, 1, 0, bias == "bull" ? "BULL" : bias == "bear" ? "BEAR" : "—", text_color=bias == "bull" ? #22c55e : bias == "bear" ? #ef4444 : #94a3b8, text_size=size.small)
    table.cell(tb, 0, 1, "Session", text_color=#94a3b8, text_size=size.small)
    table.cell(tb, 1, 1, inSB ? "SILVER BULLET" : "—", text_color=#a855f7, text_size=size.small)
