// © KingRafer — SMC Sniper Entry Strategy
// Selective: Liquidity Sweep → CHoCH → FVG/OTE → Entry
//@version=5
strategy("SMC Sniper Entry", shorttitle="SMC Sniper",
     overlay=true, pyramiding=0,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=0.5,
     process_orders_on_close=true)

// ══════════════════════════════════════
// INPUTS
// ══════════════════════════════════════
swingLen   = input.int(5, "Swing Length", minval=2, maxval=12)
rrTP1      = input.float(2.0, "TP1 RR", minval=1.0, step=0.1)
rrTP2      = input.float(3.0, "TP2 RR", minval=1.5, step=0.1)
useTP2     = input.bool(true, "Scale out at TP1 (50%)")
slBuf      = input.float(0.15, "SL Buffer ATR", minval=0.05, step=0.05)
requireOTE = input.bool(true, "Require price in OTE zone")
requireFVG = input.bool(true, "Require FVG confluence")
onlyKZ     = input.bool(false, "Only in Killzone (London/NY)")

lonStart = input.int(3, "London start (NY)", minval=0, maxval=23)
lonEnd   = input.int(5, "London end (NY)", minval=0, maxval=23)
nyStart  = input.int(8, "NY start", minval=0, maxval=23)
nyEnd    = input.int(11, "NY end", minval=0, maxval=23)

// ══════════════════════════════════════
// TIME & SWINGS
// ══════════════════════════════════════
nyHour   = hour(time, "America/New_York")
inLondon = nyHour >= lonStart and nyHour < lonEnd
inNY     = nyHour >= nyStart and nyHour < nyEnd
inKZ     = inLondon or inNY

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na
var string bias  = "neutral"

var float impHigh = na
var float impLow  = na

if not na(ph)
    prevSH := lastSH
    lastSH := ph
if not na(pl)
    prevSL := lastSL
    lastSL := pl

atrVal = ta.atr(14)

// ══════════════════════════════════════
// STRUCTURE: BOS / CHoCH (close only)
// ══════════════════════════════════════
chochBull = false
chochBear = false

if barstate.isconfirmed and not na(lastSH) and not na(lastSL)
    if close > lastSH
        if bias == "bear"
            chochBull := true
        impLow  := lastSL
        impHigh := close
        bias    := "bull"
    if close < lastSL
        if bias == "bull"
            chochBear := true
        impHigh := lastSH
        impLow  := close
        bias    := "bear"

// ══════════════════════════════════════
// LIQUIDITY SWEEP (Turtle-style reclaim)
// ══════════════════════════════════════
sweepLow  = not na(lastSL) and low < lastSL and close > lastSL and barstate.isconfirmed
sweepHigh = not na(lastSH) and high > lastSH and close < lastSH and barstate.isconfirmed

// ══════════════════════════════════════
// OTE 0.62–0.79 + 50% premium/discount
// ══════════════════════════════════════
var float oteTop = na
var float oteBot = na
var float mid50  = na

if not na(impHigh) and not na(impLow)
    rng = math.abs(impHigh - impLow)
    if rng > 0
        if impHigh > impLow
            oteTop := impHigh - rng * 0.618
            oteBot := impHigh - rng * 0.786
            mid50  := impHigh - rng * 0.5
        else
            oteTop := impLow + rng * 0.786
            oteBot := impLow + rng * 0.618
            mid50  := impLow + rng * 0.5
        if oteTop < oteBot
            tmp = oteTop
            oteTop := oteBot
            oteBot := tmp

inOTE      = not na(oteTop) and not na(oteBot) and low <= oteTop and high >= oteBot
inDiscount = not na(mid50) and close <= mid50
inPremium  = not na(mid50) and close >= mid50

// ══════════════════════════════════════
// FVG
// ══════════════════════════════════════
bullFVG = low > high[2]
bearFVG = high < low[2]
var int lastBullFvgBar = na
var int lastBearFvgBar = na
if bullFVG and barstate.isconfirmed
    lastBullFvgBar := bar_index
if bearFVG and barstate.isconfirmed
    lastBearFvgBar := bar_index
recentBullFVG = not na(lastBullFvgBar) and (bar_index - lastBullFvgBar) <= 15
recentBearFVG = not na(lastBearFvgBar) and (bar_index - lastBearFvgBar) <= 15

// ══════════════════════════════════════
// SNIPER ENTRY FILTER (stack confluence)
// ══════════════════════════════════════
// LONG sniper:
// 1) Sweep sell-side liquidity (or bullish CHoCH)
// 2) Bias bullish
// 3) Discount zone
// 4) Optional OTE
// 5) Optional FVG
// 6) Optional killzone

longCore  = bias == "bull" and inDiscount and (sweepLow or chochBull)
longOTE   = not requireOTE or inOTE
longFVG   = not requireFVG or bullFVG or recentBullFVG
longKZ    = not onlyKZ or inKZ
longSetup = longCore and longOTE and longFVG and longKZ and barstate.isconfirmed

shortCore  = bias == "bear" and inPremium and (sweepHigh or chochBear)
shortOTE   = not requireOTE or inOTE
shortFVG   = not requireFVG or bearFVG or recentBearFVG
shortKZ    = not onlyKZ or inKZ
shortSetup = shortCore and shortOTE and shortFVG and shortKZ and barstate.isconfirmed

// ══════════════════════════════════════
// ORDERS
// ══════════════════════════════════════
if longSetup and strategy.position_size == 0 and not na(lastSL)
    sl = math.min(lastSL, low) - atrVal * slBuf
    risk = close - sl
    if risk > 0
        tp1 = close + risk * rrTP1
        tp2 = close + risk * rrTP2
        strategy.entry("Long", strategy.long)
        if useTP2
            strategy.exit("L-TP1", "Long", stop=sl, limit=tp1, qty_percent=50)
            strategy.exit("L-TP2", "Long", stop=sl, limit=tp2, qty_percent=50)
        else
            strategy.exit("L-Exit", "Long", stop=sl, limit=tp1)

if shortSetup and strategy.position_size == 0 and not na(lastSH)
    sl = math.max(lastSH, high) + atrVal * slBuf
    risk = sl - close
    if risk > 0
        tp1 = close - risk * rrTP1
        tp2 = close - risk * rrTP2
        strategy.entry("Short", strategy.short)
        if useTP2
            strategy.exit("S-TP1", "Short", stop=sl, limit=tp1, qty_percent=50)
            strategy.exit("S-TP2", "Short", stop=sl, limit=tp2, qty_percent=50)
        else
            strategy.exit("S-Exit", "Short", stop=sl, limit=tp1)

// ══════════════════════════════════════
// VISUAL
// ══════════════════════════════════════
plotshape(longSetup,  title="Sniper Long",  style=shape.triangleup,   location=location.belowbar, color=#22c55e, size=size.normal, text="SNIPER")
plotshape(shortSetup, title="Sniper Short", style=shape.triangledown, location=location.abovebar, color=#ef4444, size=size.normal, text="SNIPER")

plotshape(sweepLow,  title="Sweep Low",  style=shape.xcross, location=location.belowbar, color=color.new(#22c55e, 40), size=size.tiny)
plotshape(sweepHigh, title="Sweep High", style=shape.xcross, location=location.abovebar, color=color.new(#ef4444, 40), size=size.tiny)

bgcolor(inKZ ? color.new(#a855f7, 94) : na)

var box oteBox = na
if barstate.islast and not na(oteTop) and not na(oteBot)
    if not na(oteBox)
        box.delete(oteBox)
    oteBox := box.new(bar_index - 25, oteTop, bar_index + 2, oteBot, bgcolor=color.new(#3b82f6, 90), border_color=#3b82f6, text="OTE", text_size=size.tiny, text_color=#3b82f6)

plot(mid50, "50%", color=color.new(#64748b, 50), style=plot.style_stepline)

var table tb = table.new(position.top_right, 2, 4, bgcolor=color.new(#0b0f14, 12), border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "Bias", text_color=#94a3b8, text_size=size.small)
    table.cell(tb, 1, 0, bias == "bull" ? "BULL" : bias == "bear" ? "BEAR" : "—", text_color=bias == "bull" ? #22c55e : bias == "bear" ? #ef4444 : #94a3b8, text_size=size.small)
    table.cell(tb, 0, 1, "Zone", text_color=#94a3b8, text_size=size.small)
    table.cell(tb, 1, 1, inPremium ? "PREMIUM" : inDiscount ? "DISCOUNT" : "—", text_color=#a855f7, text_size=size.small)
    table.cell(tb, 0, 2, "OTE", text_color=#94a3b8, text_size=size.small)
    table.cell(tb, 1, 2, inOTE ? "YES" : "NO", text_color=inOTE ? #22c55e : #94a3b8, text_size=size.small)
    table.cell(tb, 0, 3, "KZ", text_color=#94a3b8, text_size=size.small)
    table.cell(tb, 1, 3, inKZ ? "ACTIVE" : "—", text_color=inKZ ? #a855f7 : #94a3b8, text_size=size.small)
